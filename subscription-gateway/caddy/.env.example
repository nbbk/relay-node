# 订阅网关 Caddy 容器配置（示例，复制为 .env 后按实填）
# 注意：.env 不要进公开仓库（里面是你的面板回源地址）。

# 网关域名（裸域名，Caddy 自动签证书；须先把 A 记录指到这台服务器 IP）
GATEWAY_DOMAIN=example.com

# 面板回源地址：协议必须跟面板当前状态一致
#   面板 HTTP 时填 http://ccpanel.example.com:11111
#   面板 HTTPS 时填 https://ccpanel.example.com:11111
# 面板开关 HTTPS 后要同步改这里，改完 docker compose restart
PANEL_ORIGIN=https://ccpanel.example.com:11111

# 面板自定义订阅路径段（面板 1.3.20 反特征，设置页订阅选项卡里改的那个值）
# 没改过填 sub，改了填改的值，例如 x9f2；面板改了订阅路径后要同步改这里，改完 docker compose restart
SUB_PATH=sub

# client-config.json 在容器里的目录（对应 ./data/config 挂载）
CONFIG_DIR=/data/config
